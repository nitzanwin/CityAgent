# Optional: Trello as the ticketing system. Run `npm run setup:trello` with the key and token to create the
# board; it prints TRELLO_BOARD_ID. Without all three, tickets live in memory (seeded known issues, not persistent).
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=

# Model provider key. Without it (or if the provider fails), replies fall back to the rule-based routing.
OPENAI_API_KEY=
# Optional model overrides: a small fast model for yes/no gates, a stronger one for the conversation.
LLM_GATE_MODEL=
LLM_AGENT_MODEL=
# Optional: any OpenAI-compatible provider instead of OpenAI directly, e.g. Vercel AI Gateway
# (LLM_BASE_URL=https://ai-gateway.vercel.sh/v1, LLM_API_KEY=<gateway key>, models like openai/gpt-4.1).
LLM_BASE_URL=
LLM_API_KEY=
# Optional: which city pack in src/cities to use (default: bellevue).
CITY=
# Required. Shared secret Vapi sends on every turn (the custom-llm credential's API key); the endpoint rejects all calls without it.
VAPI_LLM_SECRET=

# Required for the call screen. Browser-safe: the Vapi public key and the assistant the call button dials. Read at build time.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
