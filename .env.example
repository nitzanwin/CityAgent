# Optional: Create real tickets in Trello. Without these, the app operates in demo mode.
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=

# Model provider key for the agent's thinking step (not used yet: replies are rule-based for now).
OPENAI_API_KEY=
# Required. Shared secret Vapi sends on every turn (the custom-llm credential's API key); the endpoint rejects all calls without it.
VAPI_LLM_SECRET=
