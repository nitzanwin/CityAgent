            &lt;div class="field field--name-field-event-time field--type-time-range field--label-hidden field__item"&gt;12:00 PM - 4:00 PM&lt;/div&gt;
      

  &lt;div class="field field--name-field-all-day-event field--type-boolean field--label-inline"&gt;
    &lt;div class="field__label"&gt;All Day Event&lt;/div&gt;
                  &lt;div class="field__item"&gt;Off&lt;/div&gt;
              &lt;/div&gt;


  &lt;div class="field field--name-field-event-registration field--type-boolean field--label-inline"&gt;
    &lt;div class="field__label"&gt;Event Registration&lt;/div&gt;
                  &lt;div class="field__item"&gt;Free&lt;/div&gt;
              &lt;/div&gt;


  &lt;div class="field field--name-field-email field--type-email field--label-inline"&gt;
    &lt;div class="field__label"&gt;Email&lt;/div&gt;
                  &lt;div class="field__item"&gt;&lt;a href="mailto:diversity@bellevuewa.gov"&gt;diversity@bellevuewa.gov&lt;/a&gt;&lt;/div&gt;
              &lt;/div&gt;


  &lt;div class="field field--name-field-telephone field--type-telephone field--label-inline"&gt;
    &lt;div class="field__label"&gt;Telephone&lt;/div&gt;
                  &lt;div class="field__item"&gt;&lt;a href="tel:425-452-6800"&gt;425-452-6800&lt;/a&gt;&lt;/div&gt;
              &lt;/div&gt;


  &lt;div class="field field--name-field-address field--type-address field--label-inline"&gt;
    &lt;div class="field__label"&gt;Location&lt;/div&gt;
                  &lt;div class="field__item"&gt;&lt;p class="address" translate="no"&gt;
        Crossroads Community Center,
        16000 NE 10th St          &lt;/p&gt;
&lt;/div&gt;
              &lt;/div&gt;


  &lt;div class="clearfix text-formatted field field--name-body field--type-text-with-summary field--label-inline"&gt;
    &lt;div class="field__label"&gt;Description&lt;/div&gt;
                  &lt;div class="field__item"&gt;&lt;p&gt;Join our main event at Crossroads Community Center! Celebrate with live performances, hands-on activities, community ofrendas, food vendors and family-friendly fun honoring the traditions of Día de los Muertos.&lt;/p&gt;&lt;p&gt;&lt;em&gt;&lt;span&gt;This event is part of the city's community-led, city-supported &lt;/span&gt;&lt;/em&gt;&lt;a href="https://bellevuewa.gov/city-government/departments/human-resources/diversity-advantage-initiative/cross-cultural-center-without-walls" data-entity-type="node" data-entity-uuid="1c87ed98-1c49-4221-8598-b35ae1054ac2" data-entity-substitution="canonical" title="Cross-Cultural Center Without Walls"&gt;&lt;em&gt;&lt;span&gt;Cross-Cultural Center without Walls&lt;/span&gt;&lt;/em&gt;&lt;/a&gt;&lt;em&gt;&lt;span&gt; and is not hosted by the City of Bellevue.&lt;/span&gt;&lt;/em&gt;&lt;/p&gt;&lt;/div&gt;
              &lt;/div&gt;


  &lt;div class="field field--name-field-hide-from-city-calendar field--type-boolean field--label-above"&gt;
    &lt;div class="field__label"&gt;Hide from City Calendar&lt;/div&gt;
                  &lt;div class="field__item"&gt;Off&lt;/div&gt;
              &lt;/div&gt;


  &lt;div class="field field--name-field-canceled field--type-boolean field--label-above"&gt;
    &lt;div class="field__label"&gt;Canceled&lt;/div&gt;
                  &lt;div class="field__item"&gt;Off&lt;/div&gt;
              &lt;/div&gt;


  &lt;div class="field field--name-field-location field--type-entity-reference field--label-above"&gt;
    &lt;div class="field__label"&gt;Location&lt;/div&gt;
        &lt;div class="field__items"&gt;
                    &lt;div class="field__item"&gt;&lt;a href="https://bellevuewa.gov/taxonomy/term/6316" hreflang="en"&gt;Crossroads Community Center&lt;/a&gt;&lt;/div&gt;
                &lt;/div&gt;
      &lt;/div&gt;

    &lt;/div&gt;
