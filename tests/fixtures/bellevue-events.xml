<item>
  <title>Eastside Día de los Muertos Celebration</title>
  <link>https://bellevuewa.gov/events/eastside-dia-de-los-muertos-celebration</link>
  <description>&lt;span class="field field--name-title field--type-string field--label-hidden"&gt;Eastside Día de los Muertos Celebration&lt;/span&gt;
&lt;span class="field field--name-uid field--type-entity-reference field--label-hidden"&gt;&lt;span lang about="https://bellevuewa.gov/users/emercado" typeof="schema:Person" property="schema:name" datatype&gt;EMercado&lt;/span&gt;&lt;/span&gt;
&lt;span class="field field--name-created field--type-created field--label-hidden"&gt;&lt;time datetime="2026-10-07T10:31:51-07:00" title="Wednesday, October 7, 2026 - 10:31" class="datetime"&gt;Wed, 10/07/2026 - 10:31&lt;/time&gt;
&lt;/span&gt;
  &lt;div class="layout layout--onecol"&gt;
    &lt;div class="layout__region layout__region--content"&gt;
      

            &lt;div class="field field--name-field-event-dates field--type-daterange field--label-hidden field__item"&gt;&lt;time datetime="2026-10-24T12:00:00Z" class="datetime"&gt;October 24 2026&lt;/time&gt;
